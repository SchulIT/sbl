{% for copy in copies %}
    {% set book = copy.book %}
    <div class="list-group-item d-flex">
        {% if book.coverFileName is not empty %}
            <div class="me-2">
                <img src="{{ vich_uploader_asset(book, 'cover') }}" class="me-2 align-self-start cover" alt="">
            </div>
        {% endif %}

        <div class="align-self-start flex-fill">
            {{ book.title }}

            <a class="badge text-bg-primary text-decoration-none" href="{{ path('book_copy', { uuid: copy.uuid }) }}" target="_blank"><i class="fas fa-barcode"></i> {{ copy.barcodeId }}</a>

            {% if book.barcodeTitle is not empty %}
                <span class="badge text-bg-secondary"><i class="fas fa-barcode"></i> {{ book.barcodeTitle }}</span>
            {% endif %}

            {% if book.subtitle is not empty %}
                <span class="text-muted d-block">{{ book.subtitle }}</span>
            {% endif %}

            {% if copy.activated %}
                <span class="badge text-bg-primary">{{ 'books.copies.activated'|trans }}</span>
            {% else %}
                <span class="badge text-bg-primary">{{ 'books.copies.not_activated.label'|trans }}</span>
            {% endif %}


            {% if copy.comment is not empty %}
                <p>
                    <i class="fas fa-info-circle"></i> {{ copy.comment }}
                </p>
            {% endif %}
        </div>


    </div>
{% endfor %}