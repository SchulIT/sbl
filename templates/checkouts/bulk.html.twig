{% extends "main.html.twig" %}

{% block title %}{{ 'checkout.label'|trans }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('dashboard') }}">{{ 'dashboard.label'|trans }}</a></li>
        <li class="breadcrumb-item active">{{ block('title') }}</li>
    </ol>
{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'checkout']) }}
{% endblock %}

{% block post_javascript %}
    <script src="{{ preload(asset('js/studentselection.js')) }}"></script>
{% endblock %}

{% block content %}
    {{ form_start(form) }}

    <div class="card">
        <div class="card-header">{{ 'label.general'|trans }}</div>
        <div class="card-body">
            <div class="studentselector">
                <div class="container-fluid px-0">
                    <div class="row row-cols-6 grades">
                        {% for grade in grades %}
                            <div class="col">
                                <a class="card card-link text-center p-2" href="#" data-selectgrade="{{ grade.name }}">
                                    {{ grade.name }}
                                </a>
                            </div>
                        {% endfor %}
                    </div>

                    <a href="#" class="btn btn-outline-primary btn-sm back-btn mb-2">
                        <i class="fas fa-arrow-left"></i> {{ 'actions.back'|trans }}
                    </a>

                    {% for grade in grades %}
                        <div class="row row-cols-6 collapse grade g-4 mb-2" id="grade-{{ grade.name }}">
                            {% for student in grade.students %}
                                <div class="col">
                                    <a class="card card-link text-center p-2 h-100 mb-0" href="#" data-selectstudent="{{ student.id }}" data-target="#{{ form.borrower.vars.id }}" data-focus-target="#{{ form.copies.vars.id }}">
                                        <span class="align-self-center">{{ student.firstname }} {{ student.lastname }}</span>
                                    </a>
                                </div>
                            {% endfor %}
                        </div>
                    {% endfor %}
                </div>
            </div>

            {{ form_widget(form) }}
        </div>
    </div>

    <div id="preview"
         data-url="{{ path('xhr_checkout') }}"
         data-select="#bulk_checkout_request_copies"
         data-maximum="{{ maximumNumberOfCopies }}"></div>

    <div class="buttons">
        <button type="submit" class="btn btn-sm btn-primary">
            <i class="fas fa-save"></i> {{ 'actions.save'|trans }}
        </button>

        <a href="javascript: history.back()" class="btn btn-sm btn-secondary">
            {{ 'actions.cancel'|trans }}
        </a>
    </div>

    {{ form_end(form) }}
{% endblock %}

{% block javascript %}
{{ parent() }}

<div class="modal" tabindex="-1" id="modalError">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ 'checkout.bulk.too_many_copies.header'|trans }}</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p>{{ 'checkout.bulk.too_many_copies.content'|trans({'%count%': maximumNumberOfCopies}) }}</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">{{ 'actions.confirm'|trans }}</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}