{% extends "main.html.twig" %}

{% block title %}{{ 'checkouts.label'|trans }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="{{ path('dashboard') }}">{{ 'dashboard.label'|trans }}</a></li>
        <li class="breadcrumb-item">{{ 'checkouts.label'|trans }}</li>
    </ol>
{% endblock %}

{% block importmap %}
    {{ importmap(['app', 'bulk', 'confirm']) }}
{% endblock %}

{% block content %}
    <div class="container-fluid px-0">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex">
                            <div class="flex-fill">
                                <form method="get" class="row row-cols-lg-auto g-1 align-items-center">
                                    <div class="col">
                                        <select name="book" class="form-select form-select-sm" data-trigger="submit">
                                            <option value="">{{ 'select.book'|trans }}</option>
                                            {% for b in books %}
                                                <option value="{{ b.uuid }}" {% if b == book %}selected{% endif %}>
                                                    {% if b.barcodeTitle is not empty %}
                                                        {{ b.barcodeTitle }}
                                                    {% else %}
                                                        {{ b.title }}
                                                        {% if b.subtitle is not empty %}({{ b.subtitle }}){% endif %}
                                                    {% endif %}
                                                    [{{ b.isbn }}]
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col">
                                        <select name="grade" class="form-select form-select-sm" data-trigger="submit">
                                            <option value="">{{ 'select.grade'|trans }}</option>
                                            {% for gradeName in grades %}
                                                <option value="{{ gradeName }}" {% if gradeName == grade %}selected{% endif %}>{{ gradeName }}</option>
                                            {% endfor %}
                                        </select>
                                    </div>

                                    <div class="col">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="all" value="1" {% if all %}checked{% endif %} {% if overdue %}disabled{% endif %} id="all" data-trigger="submit">
                                            <label class="form-check-label" for="all">
                                                {{ 'checkouts.all'|trans }}
                                            </label>
                                        </div>
                                    </div>

                                    <div class="col">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="overdue" value="1" {% if overdue %}checked{% endif %} id="overdue" data-trigger="submit">
                                            <label class="form-check-label" for="overdue">
                                                {{ 'checkouts.overdue'|trans }}
                                            </label>
                                        </div>
                                    </div>

                                    {% if book is not null or grade is not null or all == true or overdue == true %}
                                        <div class="col">
                                            <a href="{{ path('checkouts') }}" class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-times-circle"></i>
                                            </a>
                                        </div>
                                    {% endif %}
                                </form>
                            </div>

                            <div class="ms-auto">

                            </div>
                        </div>
                    </div>

                    {% if checkouts|length == 0 %}
                        <div class="card-body">
                            <div class="bs-callout bs-callout-info mt-0 mb-0">
                                <h5>{{ 'info.label'|trans }}</h5>
                                <p>{{ 'checkouts.empty'|trans }}</p>
                            </div>
                        </div>
                    {% else %}
                        <div class="card-header" data-role="bulk-actions">
                            <form method="post"
                                  action="{{ path('checkouts_bulk') }}"
                                  class="row row-cols-lg-auto g-1 align-items-center"
                                  data-confirm="true"
                                  data-confirm-modal="#confirm-bulk"
                            >
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token(bulkCsrfTokenId) }}">
                                <input type="hidden" name="checkouts" value="" data-role="bulk-values">

                                <div>
                                    <span data-role="bulk-counter"></span>
                                    {{ 'checkouts.bulk.selected'|trans }}
                                </div>

                                <div class="col">
                                    <select name="action" class="form-select form-select-sm">
                                        <option value="">{{ 'checkouts.bulk.actions.select'|trans }}</option>
                                        {% for key, action in bulkActions %}
                                            <option value="{{ key }}">{{ action|trans }}</option>
                                        {% endfor %}
                                    </select>
                                </div>

                                <div class="col">
                                    <button type="submit" class="btn btn-outline-primary btn-sm">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>
                            </form>
                        </div>

                        <div class="table-responsive">
                            <table class="table table-striped table-hover card-table">
                                <colgroup>
                                    <col class="column-sm">
                                    <col>
                                    <col>
                                    <col class="column-md">
                                    <col class="column-md">
                                    <col class="column-md">
                                    <col class="column-lg">
                                    <col>
                                </colgroup>

                                <thead>
                                <tr>
                                    <th><input type="checkbox" class="form-check-input" data-role="bulk-all"></th>
                                    <th>
                                        {{ 'label.lastname'|trans }}, {{ 'label.firstname'|trans }}
                                    </th>
                                    <th>
                                        {{ 'checkouts.book'|trans }}
                                    </th>
                                    <th>
                                        {{ 'checkouts.copy'|trans }}
                                    </th>
                                    <th>
                                        {{ 'checkouts.start'|trans }}
                                    </th>
                                    <th>
                                        {{ 'checkouts.return'|trans }}
                                    </th>
                                    <th>
                                        {{ 'checkouts.expected_return'|trans }}
                                    </th>
                                    <th>
                                        {{ 'label.comment'|trans }}
                                    </th>
                                </tr>
                                </thead>

                                <tbody>
                                {% for checkout in checkouts %}
                                <tr>
                                    <td class="align-middle">
                                        <input type="checkbox" class="form-check-input" value="{{ checkout.uuid }}" data-role="bulk-item">
                                    </td>
                                    <td class="align-middle">
                                        <a href="{{ path('show_borrower', { uuid: checkout.borrower.uuid}) }}">
                                            {{ checkout.borrower.lastname }}, {{ checkout.borrower.firstname }}
                                        </a>

                                        {% if checkout.borrower.grade is not empty %}
                                            <span class="badge text-bg-primary">{{ checkout.borrower.grade }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="align-middle">
                                        {% if checkout.bookCopy.book.coverFileName is not empty %}
                                            <img src="{{ vich_uploader_asset(checkout.bookCopy.book, 'cover') }}" class="me-2 align-self-start cover cover-small" alt="">
                                        {% endif %}

                                        <a href="{{ path('show_book', { uuid: checkout.bookCopy.book.uuid}) }}">
                                            {{ checkout.bookCopy.book.title }}
                                        </a>
                                    </td>
                                    <td class="align-middle">
                                        <a href="{{ path('book_copy', { uuid: checkout.bookCopy.uuid}) }}" class="badge text-bg-secondary text-decoration-none">
                                            <i class="fas fa-barcode"></i> {{ checkout.bookCopy.barcodeId }}
                                        </a>
                                    </td>
                                    <td class="align-middle">
                                        {{ checkout.start|format_datetime }}
                                    </td>
                                    <td class="align-middle">
                                        {% if checkout.end is not null %}
                                            {{ checkout.end|format_datetime }}
                                        {% else %}
                                            <span class="badge text-bg-secondary">{{ 'not_available'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="align-middle">
                                        {% if checkout.expectedReturnDate is not null %}
                                            {% if checkout.isOverdue(today) %}
                                                <span class="text-danger">
                                                    <i class="fas fa-exclamation-triangle"></i> {{ checkout.expectedReturnDate|format_date }}
                                                </span>
                                            {% else %}
                                                {{ checkout.expectedReturnDate|format_date }}
                                            {% endif %}
                                        {% else %}
                                            <span class="badge text-bg-secondary">{{ 'not_available'|trans }}</span>
                                        {% endif %}
                                    </td>
                                    <td class="align-middle">
                                        {{ checkout.comment }}
                                    </td>
                                </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <div class="card-footer">
                        <div class="d-flex">
                            <div class="flex-fill align-self-center">
                                {{ 'checkouts.count'|trans({'%count%': checkouts.totalCount }) }}
                            </div>

                            <div class="ms-auto">
                                {% include '@Common/includes/pagination.html.twig' with {
                                    currentFilters: {
                                        book: book?.uuid,
                                        grade: grade,
                                        all: all
                                    },
                                    currentPage: checkouts.page,
                                    paginationPath: 'checkouts',
                                    lastPage: checkouts.totalPages,
                                    showAlwaysFirstAndLast: true
                                } only %}
                            </div>
                        </div>
                    </div>
                </div>


            </div>
        </div>
    </div>
{% endblock %}

{% block javascript %}
    {{ parent() }}

    <div class="modal" id="confirm-bulk" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{ 'checkouts.bulk.confirm.header'|trans }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>{{ 'checkouts.bulk.confirm.message'|trans }}</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{ 'actions.cancel'|trans }}</button>
                    <button type="button" class="btn btn-primary" data-confirm-button>{{ 'actions.confirm'|trans }}</button>
                </div>
            </div>
        </div>
    </div>
{% endblock %}