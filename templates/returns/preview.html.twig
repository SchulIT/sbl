{% macro bookCopy(copy) %}
    {% set book = copy.book %}

    {% if book.coverFileName is not empty %}
        <img src="{{ vich_uploader_asset(book, 'cover') }}" class="mb-1 cover d-block w-100" alt="">
    {% endif %}

    <div>{{ book.title }}</div>

    <a class="badge text-bg-primary text-decoration-none" href="{{ path('book_copy', { uuid: copy.uuid }) }}" target="_blank"><i class="fas fa-barcode"></i> {{ copy.barcodeId }}</a>

    {% if book.barcodeTitle is not empty %}
        <span class="badge text-bg-secondary text-wrap"><i class="fas fa-barcode"></i> {{ book.barcodeTitle }}</span>
    {% endif %}
{% endmacro %}

{% macro bookComment(copy) %}
    {% if copy.comment is not empty %}
        <p>
            <i class="fas fa-info-circle"></i> {{ copy.comment }}
        </p>
    {% endif %}
{% endmacro %}

{% set copiesWithoutActiveCheckout = [ ] %}
{% set copiesToReturn = [ ] %}

{% for copy in copies %}
    {% if manager.isCheckedOut(copy) %}
        {% set lastCheckout = copy.checkouts.last %}
        {% if lastCheckout is not empty and lastCheckout.borrower is not null %}
            {% set copiesToReturn = copiesToReturn|merge([ copy ]) %}
        {% else %}
            {% set copiesWithoutActiveCheckout = copiesWithoutActiveCheckout|merge([ copy ]) %}
        {% endif %}
    {% else %}
        {% set copiesWithoutActiveCheckout = copiesWithoutActiveCheckout|merge([ copy ]) %}
    {% endif %}
{% endfor %}

<div class="card">
    <div class="card-header">
        {{ 'checkout.preview.label'|trans }}

        <span class="badge rounded-pill text-bg-primary">
            <i class="fa-solid fa-book"></i> {{ copies|length }}
        </span>

        {% if copiesToReturn|length > 0 %}
            <span class="badge rounded-pill text-bg-success">
            <i class="fas fa-check"></i> {{ copiesToReturn|length }}
        </span>
        {% endif %}

        {% if copiesWithoutActiveCheckout|length > 0 %}
            <span class="badge rounded-pill text-bg-warning">
                <i class="fas fa-exclamation-triangle"></i> {{ copiesWithoutActiveCheckout|length }}
            </span>
        {% endif %}
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap align-items-stretch">
            {% for copy in copiesToReturn %}
                <div class="copy mb-2 me-2 alert alert-success">
                    {{ _self.bookCopy(copy) }}

                    {% set lastCheckout = copy.checkouts.last %}
                    {% if lastCheckout is not empty and lastCheckout.borrower is not null %}
                        <p>
                            <i class="fas fa-user"></i> {{ lastCheckout.borrower.lastname }}, {{ lastCheckout.borrower.firstname }}
                        </p>
                    {% endif %}

                    {{ _self.bookComment(copy) }}
                </div>
            {% endfor %}

            {% for copy in copiesWithoutActiveCheckout %}
                <div class="copy mb-2 me-2 alert alert-warning">
                    {{ _self.bookCopy(copy) }}

                    <p>{{ 'return.errors.not_checked_out'|trans }}</p>

                    {{ _self.bookComment(copy) }}
                </div>
            {% endfor %}
        </div>
    </div>
</div>
